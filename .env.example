## Here define the environment variables for the application. 
You can copy this file to .env and fill in the values as needed.

## Here I have utilzied the Open API for the LLM provider,
 Chroma for the vector database, and Sentence Transformers for the embedding model. You can change these values to use other providers or models as needed.
APP_ENV=development
LLM_PROVIDER=openai
VECTOR_BACKEND=chroma
EMBEDDING_BACKEND=sentence_transformer
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini


EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CHROMA_PATH=../data/chroma
CORPUS_MANIFEST_PATH=../data/chroma/corpus_manifest.json
AUDIT_DB_PATH=../data/audit.db
COLLECTION_NAME=stock_news_articles

## Define the parameters for the retrieval process. These parameters can be tuned to improve the quality of the retrieved results.

DENSE_K=8
LEXICAL_K=8
FINAL_TOP_K=5
MAX_CHUNKS_PER_ARTICLE=2
MIN_RETRIEVAL_SCORE=0.20

# Enter the current rates for the model selected above.
INPUT_COST_PER_MILLION=0
OUTPUT_COST_PER_MILLION=0

## Define The Local Host for the User Interface ###
CORS_ORIGINS=http://localhost:5176
